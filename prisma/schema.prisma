  Status         Int                      @default(0, map: "DF__Attempt__Status__72910220") @db.TinyInt
  StartedOn      DateTime                 @default(now(), map: "DF__Attempt__Started__73852659") @db.DateTime
  SubmittedOn    DateTime?                @db.DateTime
  GradedOn       DateTime?                @db.DateTime
  PausedTotalSec Int                      @default(0, map: "DF__Attempt__PausedT__74794A92")
  ScoreTotal     Decimal?                 @db.Decimal(7, 2)
  DeviceJson     String?                  @db.NVarChar(400)
  IpAddress      String?                  @db.VarChar(45)
  FranchiseId    BigInt?
  IsActive       Boolean                  @default(true, map: "DF__Attempt__IsActiv__756D6ECB")
  IsDeleted      Boolean                  @default(false, map: "DF__Attempt__IsDelet__76619304")
  CreatedBy      String                   @db.NVarChar(500)
  CreatedOn      DateTime                 @default(now(), map: "DF__Attempt__Created__7755B73D") @db.DateTime
  CreatedIp      String?                  @db.NVarChar(50)
  ModifiedBy     String?                  @db.NVarChar(500)
  ModifiedOn     DateTime?                @db.DateTime
  ModifiedIp     String?                  @db.NVarChar(50)
  RowVer         Unsupported("timestamp")
  MockTest       MockTest                 @relation(fields: [MockTestId], references: [MockTestId], onUpdate: NoAction, map: "FK__Attempt__MockTes__70A8B9AE")
  AttemptAnswer  AttemptAnswer[]
  AttemptEvent   AttemptEvent[]
  AttemptSection AttemptSection[]

  @@index([StudentId, MockTestId], map: "IX_Attempt_Student")
  @@index([MockTestId, Status], map: "IX_Attempt_Test")
}

